# Supabase - required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role - server-only, NUNCA exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI - para migraciones y generación de tipos
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Primer admin - para el script de seed.
# Generá una contraseña fuerte (mínimo 12 caracteres) con un gestor de contraseñas.
# El seed abortará si alguna de estas variables está vacía.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Tests de integración (Supabase local) — valores de `supabase status`
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_first_blades
# TEST_SUPABASE_URL=
# TEST_SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones por email (Gmail API) — server-only, NUNCA exponer al cliente.
# Envía como contacto@first-blades.com vía service account con domain-wide
# delegation (scope único: https://www.googleapis.com/auth/gmail.send).
# Dirección remitente (buzón real de Workspace).
GMAIL_SENDER_ADDRESS=
# JSON key del service account codificada en base64 (una sola línea):
#   base64 -i key.json    (macOS)   /   base64 -w0 key.json   (Linux)
# Se usa base64 porque la private_key tiene saltos de línea que un .env rompe,
# y un `#` truncaría el valor. La key NUNCA se commitea; cargar en Vercel.
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
# Solo si el buzón a impersonar difiere de GMAIL_SENDER_ADDRESS. Si contacto@
# es un buzón real, dejar vacío (se impersona esa misma dirección).
# GMAIL_IMPERSONATED_USER=

# Cron job secret — protege el endpoint de purga de documentos rechazados.
# Configurar también en Vercel Project Settings > Environment Variables.
# Generá un valor aleatorio fuerte: openssl rand -hex 32
CRON_SECRET=
